# Copier ce fichier en .env et remplir les valeurs. Ne jamais versionner le .env.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/report_card

# Secret JWT long et aléatoire. Le générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Secret des QR codes de vérification des bulletins (indépendant du JWT_SECRET, pour qu'une
# rotation du JWT ne rende pas invalides les bulletins déjà imprimés). Même commande que ci-dessus.
BULLETIN_VERIFY_SECRET=

# Origine(s) du frontend, séparées par des virgules. La première sert aux liens des emails.
FRONTEND_URL=http://localhost:8080
# Adresse publique utilisée dans les liens des emails (par défaut : la première de FRONTEND_URL).
# En local, mettre l'adresse Wi-Fi du poste (ex. http://192.168.1.10:8080) pour ouvrir les liens depuis un téléphone.
PUBLIC_APP_URL=

# Identité de l'établissement (emails, SMS)
SCHOOL_NAME=COLLÈGE BILINGUE CEDEVE
SCHOOL_SHORT_NAME=CEDEVE

# SMTP (Gmail : mot de passe d'application de 16 caractères)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# Twilio (SMS, facultatif)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# true : aucun email ni SMS n'est envoyé (journal uniquement). À activer pour les tests en local
# avec des contacts fictifs ; à laisser vide en production.
MESSAGES_DRY_RUN=

# Emails de suivi aux parents (nouvelle évaluation, note publiée). Mettre false pour les couper.
# Attention : un compte Gmail gratuit est limité à environ 500 emails par jour.
PARENT_EMAILS=

# Tâche planifiée Vercel (rappels de clôture aux enseignants, chaque jour à 6 h UTC) : secret long et aléatoire
CRON_SECRET=
# Fuseau horaire des dates affichées dans les notifications (par défaut Africa/Douala)
SCHOOL_TIMEZONE=

# Seed (npm run seed)
SEED_SCHOOL_YEAR=
SEED_ADMIN_EMAIL=admin@eduflow.local
